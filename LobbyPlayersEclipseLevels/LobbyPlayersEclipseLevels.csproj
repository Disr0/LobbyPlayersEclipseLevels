        <PackageReference Include="RoR2BepInExPack" Version="*" />
	</ItemGroup>

	<Target Name="PostBuild" AfterTargets="Build">
		<Copy SourceFiles="$(TargetDir)$(ProjectName).dll" DestinationFolder="C:\Users\disro\AppData\Roaming\r2modmanPlus-local\RiskOfRain2\profiles\ListEclipseLevelsMod\BepInEx\plugins\" />

